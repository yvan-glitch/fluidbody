{
  "name": "fluidbody",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint App.js src",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/",
      "/my-app/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/",
      "<rootDir>/my-app/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ]
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@kingstinct/react-native-healthkit": "^14.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.101.1",
    "expo": "54.0.34",
    "expo-apple-authentication": "~8.0.8",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-calendar": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-crypto": "15.0.9",
    "expo-dev-client": "6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "19.0.22",
    "expo-image": "~3.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-screen-orientation": "9.0.9",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.17",
    "node-libs-react-native": "^1.2.1",
    "react": "19.1.0",
    "react-native": "npm:react-native-tvos@0.81.5-2",
    "react-native-health-connect": "^3.5.3",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-purchases": "^9.15.0",
    "react-native-purchases-ui": "^9.15.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3"
  },
  "private": true,
  "overrides": {
    "@expo/fingerprint": "0.15.4"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-randombytes"
        ]
      }
    }
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-tvos/config-tv": "^0.1.6",
    "@types/react": "~19.1.10",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^7.1.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2"
  }
}
