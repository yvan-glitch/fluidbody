{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "development-tv": {
      "extends": "development",
      "env": {
        "EXPO_TV": "1"
      }
    },
    "preview-tv": {
      "extends": "preview",
      "env": {
        "EXPO_TV": "1"
      }
    },
    "production-tv": {
      "extends": "production",
      "env": {
        "EXPO_TV": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6761364962",
        "appleTeamId": "R5V88AS9MX"
      }
    }
  }
}
