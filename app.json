{
  "expo": {
    "name": "FluidBody+",
    "slug": "fluidbody",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000e18"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ytissot.fluidbody",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "b-cdn.net": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSExceptionAllowsInsecureHTTPLoads": false
            },
            "supabase.co": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
            }
          }
        },
        "NSHealthShareUsageDescription": "FluidBody utilise HealthKit pour enregistrer vos séances et remplir vos anneaux Fitness.",
        "NSHealthUpdateUsageDescription": "FluidBody enregistre vos séances de Pilates comme exercices dans Santé."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ytissot.fluidbody"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c94beda1-885e-48cd-83ca-2a1e2f10da79"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c94beda1-885e-48cd-83ca-2a1e2f10da79"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-localization",
      "expo-apple-authentication",
      [
        "react-native-health",
        {
          "healthSharePermission": "FluidBody utilise HealthKit pour enregistrer vos séances et remplir vos anneaux Fitness.",
          "healthUpdatePermission": "FluidBody enregistre vos séances de Pilates comme exercices dans Santé.",
          "isClinicalDataEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#AEEF4D"
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
