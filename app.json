{
  "expo": {
    "name": "FluidBody+",
    "slug": "fluidbody",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "fluidbody",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000e18"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ytissot.fluidbody",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "b-cdn.net": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSExceptionAllowsInsecureHTTPLoads": false
            },
            "supabase.co": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
            }
          }
        },
        "NSPhotoLibraryUsageDescription": "FluidBody+ n'accède pas à ta photothèque. — FluidBody+ does not access your photo library.",
        "NSHealthShareUsageDescription": "Fluidbody utilise votre fréquence cardiaque mesurée par votre Apple Watch pour afficher en temps réel votre intensité d'effort pendant les séances de Pilates et enregistrer votre activité dans l'app Santé. — Fluidbody uses heart-rate data from your Apple Watch to display your real-time effort intensity during Pilates sessions and to log your activity in the Health app.",
        "NSHealthUpdateUsageDescription": "Fluidbody enregistre vos séances de Pilates dans Apple Santé (durée, calories estimées, fréquence cardiaque) pour que vous puissiez suivre votre progression. — Fluidbody logs your Pilates sessions to Apple Health (duration, estimated calories, heart rate) so you can track your progress.",
        "NSCalendarsFullAccessUsageDescription": "Fluidbody peut planifier tes séances de Pilates dans ton agenda pour t'aider à tenir ta routine. — Fluidbody can schedule your Pilates sessions in your calendar to help you stick to your routine.",
        "NSCalendarsUsageDescription": "Fluidbody peut planifier tes séances de Pilates dans ton agenda pour t'aider à tenir ta routine. — Fluidbody can schedule your Pilates sessions in your calendar to help you stick to your routine."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeHealth",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeFitness",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePurchaseHistory",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePerformanceData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUsageData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          }
        ],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": []
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#001a2e"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ytissot.fluidbody",
      "permissions": [
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_FLOORS_CLIMBED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.WRITE_WEIGHT",
        "android.permission.health.WRITE_HEIGHT",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_ACTIVE_CALORIES_BURNED",
        "android.permission.health.WRITE_HEART_RATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c94beda1-885e-48cd-83ca-2a1e2f10da79"
      },
      "legal": {
        "privacyUrl": "https://yvan-glitch.github.io/fluidbody-privacy/",
        "termsUrl": "https://yvan-glitch.github.io/fluidbody-privacy/terms/",
        "termsUrlEn": "https://yvan-glitch.github.io/fluidbody-privacy/terms/en/",
        "termsVersion": "1.0"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c94beda1-885e-48cd-83ca-2a1e2f10da79"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-localization",
      "expo-apple-authentication",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Fluidbody utilise votre fréquence cardiaque mesurée par votre Apple Watch pour afficher en temps réel votre intensité d'effort pendant les séances de Pilates et enregistrer votre activité dans l'app Santé. — Fluidbody uses heart-rate data from your Apple Watch to display your real-time effort intensity during Pilates sessions and to log your activity in the Health app.",
          "NSHealthUpdateUsageDescription": "Fluidbody enregistre vos séances de Pilates dans Apple Santé (durée, calories estimées, fréquence cardiaque) pour que vous puissiez suivre votre progression. — Fluidbody logs your Pilates sessions to Apple Health (duration, estimated calories, heart rate) so you can track your progress.",
          "background": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#AEEF4D"
        }
      ],
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      [
        "expo-calendar",
        {
          "calendarPermission": "Fluidbody peut planifier tes séances de Pilates dans ton agenda pour t'aider à tenir ta routine. — Fluidbody can schedule your Pilates sessions in your calendar to help you stick to your routine."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fluidbody utilise l'appareil photo uniquement pour scanner le QR code de pairage avec l'Apple TV. Aucune image n'est enregistrée. — Fluidbody uses the camera only to scan the Apple TV pairing QR code. No image is stored."
        }
      ],
      "./plugins/withLiquidGlass.js",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ]
  }
}
