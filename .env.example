# Copier vers .env à la racine du projet (fichier ignoré par git).
# Expo injecte automatiquement les variables EXPO_PUBLIC_* au build.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — DSN public du projet React Native créé sur sentry.io.
# Required for crash monitoring in TestFlight/App Store builds.
# Laisser vide en local = Sentry no-op (les Sentry.* restent appelables).
# Procédure complète : voir docs/SENTRY_SETUP.md
EXPO_PUBLIC_SENTRY_DSN=https://xxxxx@oXXX.ingest.sentry.io/XXXXXX

# Server-only secrets for the sign-video-url edge function — set these as
# Supabase function secrets (not here, not as EXPO_PUBLIC_*). Listed for
# reference only; see supabase/README.md.
#   BUNNY_TOKEN_KEY
#   BUNNY_PULL_ZONE_HOST            (default: vz-1a4e2cac-0dc.b-cdn.net)
#   SIGNED_URL_TTL_SECONDS          (default: 1800)
#   REVENUECAT_SECRET_API_KEY       (optional)
#   REVENUECAT_ENTITLEMENT_ID       (default: Fluidbody Pilates Pro)
#   ADMIN_EMAILS                    (comma-separated, optional)
