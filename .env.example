# Copier vers .env à la racine du projet (fichier ignoré par git).
# Expo injecte automatiquement les variables EXPO_PUBLIC_* au build.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — DSN public du projet React Native créé sur sentry.io.
# Laisser vide en local pour skip l'init (Sentry devient no-op).
# Activer pour TestFlight/prod : remplir avec le DSN puis `eas build` (var injectée au bundle).
EXPO_PUBLIC_SENTRY_DSN=
